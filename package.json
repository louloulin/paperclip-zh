{
  "name": "paperclip-zh-pack",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Chinese language pack for Paperclip — browser extension, zero host changes",
  "type": "module",
  "license": "MIT",
  "bin": {
    "paperclip-zh-pack": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "manifest.json",
    "popup.html",
    "dict",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "watch": "node scripts/build.mjs --watch",
    "extract": "node scripts/extract-strings.mjs",
    "extract:server": "node scripts/extract-server-strings.mjs",
    "coverage": "node scripts/coverage.mjs",
    "serve": "node bin/cli.mjs serve",
    "package": "node scripts/package.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
